{
  "name": "orbit-golf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"vite\" \"node server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "tsc --noEmit && vite build",
    "test": "node scripts/run-tests.js",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test:e2e": "node scripts/browser-smoke.js",
    "audit": "node scripts/audit.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.61.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
