# Multiplayer runs on Supabase Realtime (Presence + Broadcast). No tables, no auth, no
# game server. Copy this to `.env.local` for dev, and set the same two vars in Vercel.
#
# Both are public/client-side values — the publishable (anon) key is safe to ship.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=YOUR-PUBLISHABLE-ANON-KEY

# Without these, single-player works fine and multiplayer shows a "not configured" notice.
